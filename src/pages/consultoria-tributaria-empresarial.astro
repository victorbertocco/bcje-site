---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoCard from '../components/InfoCard.astro';
import CtaButton from '../components/CtaButton.astro';
import ContatoWhatsApp from '../components/ContatoWhatsApp.astro';

/*
 * Landing page de campanha, migrada de wordpress-export/consultoria-tributaria-empresarial/.
 * Não está no menu principal (decisão de 09/08/2026, ver ARQUITETURA-NOVO-SITE.md).
 *
 * Ajustes de compliance na migração (Provimento 205/2021):
 * - Removido integralmente o bloco de depoimentos (widget Trustindex/Google Reviews com
 *   nome, foto e avaliação de clientes reais) — vedação absoluta a depoimentos de clientes.
 * - CTA "FALE AGORA COM UM ESPECIALISTA" (caixa alta, imperativo de urgência artificial)
 *   reescrito para "Fale com um especialista", mesmo texto já usado nas outras LPs migradas.
 * - Cards de "Vantagens" tinham chamadas em negrito com tom imperativo/comercial
 *   ("Pague apenas o necessário e recupere tributos indevidos", "Regularize sua empresa
 *   com respaldo legal", "Prevenção contra multas e execuções", "Mais liquidez e
 *   eficiência na gestão"); mantido apenas o texto descritivo de cada card, mesma decisão
 *   já tomada em recuperacao-credito-tributario.astro.
 * - Seção de contato do original (mapa incorporado + ícones de e-mail, telefone e endereço)
 *   não foi migrada porque essas informações já são exibidas pelo Footer.astro do site novo.
 * - A página original não tinha seção de Perguntas Frequentes; nenhum FAQ foi criado para
 *   não inventar conteúdo, e o componente Faq não é usado nesta página.
 * - Não havia formulário de captação de lead na página original, só WhatsApp; mantido assim,
 *   mesma decisão já tomada para /contatos (fica para quando a infra de e-mail existir).
 * - Nenhuma citação de lei, processo ou tese específica no conteúdo original a preservar.
 */
const whatsappHref =
  'https://wa.me/5511976547272?text=' +
  encodeURIComponent(
    'Olá! Tenho interesse em entender melhor sobre consultoria tributária e planejamento fiscal para minha empresa.'
  );

const desafios = [
  'Risco de autuações',
  'Pagamentos indevidos por falhas de enquadramento',
  'Falta de estratégia fiscal',
  'Exposição a contingências tributárias',
];

const servicos = [
  {
    title: 'Assessoria Jurídica Integrada',
    items: [
      'Análise e revisão de contratos empresariais',
      'Elaboração e adequação de instrumentos contratuais',
      'Apoio em reorganizações societárias',
      'Estruturação jurídica preventiva',
      'Orientação estratégica em decisões empresariais',
      'Suporte jurídico consultivo contínuo',
    ],
  },
  {
    title: 'Gestão de Passivo Tributário',
    items: [
      'Diagnóstico tributário completo da empresa',
      'Revisão de enquadramento e riscos fiscais',
      'Elaboração de estratégias fiscais preventivas',
      'Orientação sobre regimes e incentivos legais',
    ],
  },
  {
    title: 'Planejamento e Estratégia Tributária Empresarial',
    items: [
      'Identificação de tributos pagos indevidamente',
      'Restituição ou compensação de créditos fiscais',
      'Revisão de impostos como ICMS, PIS, COFINS, IRPJ, CSLL',
      'Assessoria para manter a conformidade tributária',
    ],
  },
];

const etapas = [
  {
    title: '1. Reunião de diagnóstico',
    description: 'Entendimento do cenário tributário e identificação dos principais pontos de atenção.',
  },
  {
    title: '2. Avaliação técnica e documental',
    description: 'Revisão da estrutura fiscal e análise de riscos potenciais.',
  },
  {
    title: '3. Plano estratégico personalizado',
    description: 'Diretrizes jurídicas ajustadas à realidade do seu negócio.',
  },
  {
    title: '4. Acompanhamento contínuo',
    description: 'Monitoramento fiscal mensal e suporte consultivo para decisões empresariais.',
  },
];

const indicacoes = [
  'Empresas de pequeno e médio porte',
  'Negócios em fase de crescimento',
  'Empresas sem departamento jurídico interno estruturado',
  'Empresas que buscam previsibilidade fiscal e segurança jurídica',
];

const diferenciais = [
  'Análise individualizada',
  'Suporte jurídico permanente',
  'Foco preventivo e estratégico',
  'Transparência em todas as fases',
];

const vantagens = [
  {
    title: 'Redução Legal de Custos e Impostos Pagos',
    description:
      'A revisão tributária identifica impostos pagos a mais, permitindo restituições e compensações que contribuem para a lucratividade da empresa.',
  },
  {
    title: 'Segurança Jurídica',
    description:
      'Com assessoria especializada, sua empresa reduz o risco de autuações e penalidades, mantendo conformidade com a legislação e os órgãos reguladores.',
  },
  {
    title: 'Menos Riscos Fiscais',
    description:
      'Buscamos reduzir o risco de cobranças inesperadas, ajudando sua empresa a manter suas obrigações tributárias em dia.',
  },
  {
    title: 'Previsibilidade Financeira',
    description:
      'A recuperação de créditos e a negociação de passivos podem melhorar o fluxo de caixa, contribuindo para investimentos estratégicos no negócio.',
  },
];
---

<BaseLayout
  title="Consultoria Tributária e Empresarial"
  description="Assessoria jurídica empresarial com foco em governança tributária, mitigação de riscos e suporte contínuo para decisões fiscais e estratégicas, conduzida por advogados especialistas em Direito Tributário e Empresarial."
>
  <section class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-bcje-accent">
      Bertocco Consultoria Jurídica Estratégica
    </p>
    <h1 class="mt-2 text-3xl font-bold text-bcje-ink sm:text-4xl">
      Consultoria Tributária e Jurídica Para Empresas
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-bcje-graphite">
      Assessoria jurídica empresarial com foco em governança tributária, mitigação de riscos e suporte
      contínuo para decisões fiscais e estratégicas.
    </p>
    <p class="mt-4 text-lg leading-relaxed text-bcje-graphite">
      Fortalecendo a estrutura tributária da sua empresa com atuação preventiva, consultiva e contínua.
    </p>
    <ul class="mx-auto mt-6 max-w-xl space-y-2 text-left text-sm text-bcje-graphite">
      <li>Mais de <strong>10 anos de atuação</strong> em Direito Tributário e Empresarial.</li>
      <li>Atendimento em todo o Brasil.</li>
    </ul>
    <div class="mt-8">
      <CtaButton href={whatsappHref} external>Fale com um especialista</CtaButton>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 text-center">
    <h2 class="text-2xl font-bold text-bcje-ink sm:text-3xl">
      Empresas que não possuem acompanhamento tributário estruturado frequentemente enfrentam:
    </h2>
    <ul class="mx-auto mt-6 max-w-xl space-y-2 text-left text-sm text-bcje-graphite">
      {
        desafios.map((item) => (
          <li class="flex gap-2">
            <span class="text-bcje-accent">·</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-lg leading-relaxed text-bcje-graphite">
      Uma consultoria tributária empresarial atua de forma preventiva e estratégica, organizando o
      cenário fiscal e jurídico da empresa e estruturando decisões seguras.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-bcje-accent">
      O que a Consultoria Empresarial Contempla
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicos.map((servico) => (
          <div class="rounded-2xl border border-bcje-mist bg-white p-6">
            <h3 class="text-lg font-bold text-bcje-ink">{servico.title}</h3>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-bcje-graphite">
              {servico.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-bcje-accent">·</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <h2 class="text-center text-2xl font-bold text-bcje-ink sm:text-3xl">
      Como Funciona a Consultoria Tributária Empresarial
    </h2>
    <p class="mt-6 text-center text-lg leading-relaxed text-bcje-graphite">
      A consultoria é organizada em etapas claras para atender a necessidade da sua empresa.
    </p>
    <ol class="mt-10 space-y-6">
      {
        etapas.map((etapa) => (
          <li class="flex gap-4 rounded-2xl border border-bcje-mist bg-white p-6">
            <div>
              <h3 class="text-base font-bold text-bcje-ink">{etapa.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-bcje-graphite">{etapa.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-bcje-ink">Para quais empresas é indicado</h2>
        <ul class="mt-4 space-y-2 text-sm text-bcje-graphite">
          {
            indicacoes.map((item) => (
              <li class="flex gap-2">
                <span class="text-bcje-accent">·</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-bcje-ink">Diferencial da Atuação</h2>
        <ul class="mt-4 space-y-2 text-sm text-bcje-graphite">
          {
            diferenciais.map((item) => (
              <li class="flex gap-2">
                <span class="text-bcje-accent">·</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-bcje-accent">Vantagens</p>
    <h2 class="mt-2 text-3xl font-bold text-bcje-ink">
      E por que contratar uma consultoria tributária empresarial especializada?
    </h2>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {vantagens.map((v) => <InfoCard title={v.title} description={v.description} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <ContatoWhatsApp
      heading="Ficou alguma dúvida?"
      description="Entre em contato e descubra o potencial tributário da sua empresa."
    />
  </section>
</BaseLayout>
