---
interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = 'Fale com o escritório',
  description = 'Atendimento inicial por WhatsApp, de segunda a sexta, em horário comercial.',
} = Astro.props;
---

<section class="rounded-3xl bg-bcje-accent px-8 py-12 text-center text-white">
  <h2 class="text-2xl font-bold">{heading}</h2>
  <p class="mx-auto mt-3 max-w-xl text-sm text-white/85">{description}</p>
  <a
    href="https://wa.me/5511976547272"
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-bcje-accent transition-colors hover:bg-bcje-fog"
  >
    Conversar no WhatsApp
  </a>
</section>
