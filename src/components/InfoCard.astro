---
interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class="group block rounded-2xl border border-bcje-mist bg-white p-6 transition-colors hover:border-bcje-accent"
>
  <h3 class="text-lg font-bold text-bcje-ink">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-bcje-graphite">{description}</p>
  {
    href && (
      <span class="mt-4 inline-block text-sm font-semibold text-bcje-accent group-hover:underline">
        Saiba mais
      </span>
    )
  }
</Tag>
