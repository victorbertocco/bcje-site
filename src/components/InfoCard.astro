---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  href?: string;
  image?: ImageMetadata;
}

const { title, description, href, image } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class="group block overflow-hidden rounded-2xl border border-bcje-mist bg-white transition-colors hover:border-bcje-accent"
>
  {
    image && (
      <Image src={image} alt="" width={300} height={214} class="h-36 w-full object-cover" />
    )
  }
  <div class="p-6">
    <slot name="icon" />
    <h3 class="text-lg font-bold text-bcje-ink">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-bcje-graphite">{description}</p>
    {
      href && (
        <span class="mt-4 inline-block text-sm font-semibold text-bcje-accent group-hover:underline">
          Saiba mais
        </span>
      )
    }
  </div>
</Tag>
